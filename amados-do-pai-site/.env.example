# Nenhuma variável abaixo é obrigatória para rodar o site localmente.
# O site funciona com fallbacks (WhatsApp, seção Instagram oculta) quando
# estas variáveis não estão configuradas.

# URL pública do site (domínio ainda não definido — ver CONTENT_VALIDATION.md).
# Usada para gerar sitemap.xml, robots.txt e URLs absolutas de Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.amadosdopai.org.br

# Instagram Graph API (conta profissional). Sem estas variáveis, a seção
# do Instagram só aparece se NEXT_PUBLIC_INSTAGRAM_URL estiver definido, e
# nesse caso exibe apenas o botão de perfil (sem grade de posts).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_USERNAME=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# E-mail de contato (opcional). Envio via API HTTP do Resend (sem SDK).
# Sem estas variáveis, o formulário de contato continua funcional e o
# usuário recebe o link de fallback para o WhatsApp.
RESEND_API_KEY=
CONTACT_EMAIL=
